            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(60deg, transparent, rgba(255,255,255,0.5), transparent);
            transform: rotate(30deg);
            animation: shimmer 3s infinite linear;
