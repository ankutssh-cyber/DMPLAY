        .sticky-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(8, 0, 0, 0.96);
            padding: 10px 14px;
            box-shadow: 0 -4px 25px rgba(0,0,0,0.9);
            z-index: 999;
            border-top: 2px solid #ffd700;
            backdrop-filter: blur(10px);
        }

        .sticky-btn {
            max-width: 450px;
            margin: 0 auto;
            background: var(--gold-grad);
            color: #000;
            display: block;
            text-align: center;
            padding: 12px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 900;
            text-decoration: none;
            text-transform: uppercase;
