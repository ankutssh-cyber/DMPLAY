            document.getElementById('rBonus').innerText = '₹' + depBonus.toLocaleString('en-IN');
            document.getElementById('rRef').innerText = '₹' + refReward.toLocaleString('en-IN');
            document.getElementById('rSal').innerText = '₹' + dailySalary.toLocaleString('en-IN');

            const monthTotal = dailySalary * 30;
            document.getElementById('rTotal').innerText = '₹' + monthTotal.toLocaleString('en-IN');
        }
        calc();
    </script>
</body>
</html>
