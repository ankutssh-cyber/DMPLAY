            --bg-gradient: radial-gradient(circle at center, #3d0303 0%, #1c0101 60%, #080000 100%);
            --gold-grad: linear-gradient(180deg, #ffe600 0%, #ff9900 100%);
            --red-grad: linear-gradient(180deg, #e50914 0%, #800000 100%);
            --text-gold: #ffd700;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: var(--bg-gradient);
            color: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            padding-bottom: 90px;
        }

        #coinCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .container {
            max-width: 480px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
            padding: 0 12px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 15px;
            background: rgba(10, 0, 0, 0.95);
            border-bottom: 2px solid #ffd700;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
        }

        .header-logo-container {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-logo-svg {
            width: 34px;
            height: 34px;
            filter: drop-shadow(0 0 6px #ffd700);
        }

        .logo-text {
            font-size: 22px;
            font-weight: 900;
            background: linear-gradient(180deg, #fff 0%, #ffd700 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1px;
        }

        .header-btn {
            background: var(--gold-grad);
            color: #000;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 900;
            font-size: 13px;
            text-decoration: none;
            box-shadow: 0 0 15px rgba(255, 153, 0, 0.8);
            animation: pulseGlow 2s infinite ease-in-out;
        }

        .ticker-wrap {
            background: linear-gradient(90deg, #4a0000, #900000, #4a0000);
            border-top: 1px solid rgba(255,215,0,0.4);
            border-bottom: 1px solid rgba(255,215,0,0.4);
            overflow: hidden;
            white-space: nowrap;
            padding: 6px 0;
            font-size: 12px;
            color: #ffd700;
            font-weight: 700;
        }

        .ticker-move {
            display: inline-block;
            animation: ticker 15s linear infinite;
        }

        .ticker-item {
            display: inline-block;
            margin-right: 35px;
        }

        .hero-banner {
            width: 100%;
            border-radius: 20px;
            margin-top: 15px;
            border: 3px solid #ffd700;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.4);
            overflow: hidden;
            background: #000;
        }

        .hero-banner svg {
            width: 100%;
            height: auto;
            display: block;
        }

        .joined-tag {
            background: rgba(255, 69, 0, 0.3);
            border: 1px solid rgba(255, 153, 0, 0.8);
            border-radius: 20px;
            padding: 6px 18px;
            width: max-content;
            margin: 18px auto 10px;
            font-size: 13px;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 0 12px rgba(255,69,0,0.4);
        }

        .main-title {
            text-align: center;
            font-size: 28px;
            font-weight: 900;
            color: var(--text-gold);
            text-shadow: 0 0 10px rgba(255,215,0,0.5), 0 3px 6px #000;
            line-height: 1.2;
            margin-bottom: 8px;
        }

        .sub-title {
            text-align: center;
            font-size: 13px;
            color: #f0e6d2;
            margin-bottom: 15px;
            line-height: 1.5;
            padding: 0 8px;
        }

        .code-box {
            background: rgba(0, 0, 0, 0.7);
            border: 2px dashed #ffd700;
            border-radius: 30px;
            padding: 10px 22px;
            width: max-content;
            margin: 0 auto 15px;
            font-size: 14px;
            font-weight: 800;
            color: #fff;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.4);
            transition: transform 0.2s;
        }

        .code-box:active { transform: scale(0.95); }

