        .grid-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0; }
        .card-item {
            background: linear-gradient(135deg, #ff8c00 0%, #e65100 100%);
            border-radius: 16px;
            padding: 16px 10px;
            text-align: center;
            border: 2px solid #ffb74d;
            box-shadow: 0 6px 15px rgba(0,0,0,0.4);
