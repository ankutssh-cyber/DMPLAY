            background: linear-gradient(180deg, #b71c1c 0%, #5d0000 100%);
            border: 2px solid #ff4500;
            border-radius: 25px;
            padding: 10px 20px;
            text-align: center;
            font-size: 16px;
            font-weight: 900;
            color: #ffd700;
            margin: 25px 0 15px;
